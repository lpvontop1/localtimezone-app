<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2: Jadwal Sholat -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wpLoc"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#9AA3C7"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🕌 Jadwal Sholat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wpNextName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFB454"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="Berikutnya: Subuh" />

        <TextView
            android:id="@+id/wpNextTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8EBFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="04:24 · 2 j 10 mnt lagi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <LinearLayout style="@style/WPRow">
            <TextView style="@style/WPName" android:id="@+id/wpL1" android:text="Subuh" />
            <TextView style="@style/WPTime" android:id="@+id/wpFajr" android:text="--:--" />
            <TextView style="@style/WPName" android:id="@+id/wpL2" android:text="Dzuhur" />
            <TextView style="@style/WPTime" android:id="@+id/wpDhuhr" android:text="--:--" />
            <TextView style="@style/WPName" android:id="@+id/wpL3" android:text="Maghrib" />
            <TextView style="@style/WPTime" android:id="@+id/wpMaghrib" android:text="--:--" />
        </LinearLayout>

        <LinearLayout style="@style/WPRow">
            <TextView style="@style/WPName" android:id="@+id/wpL4" android:text="Terbit" />
            <TextView style="@style/WPTime" android:id="@+id/wpSunrise" android:text="--:--" />
            <TextView style="@style/WPName" android:id="@+id/wpL5" android:text="Ashar" />
            <TextView style="@style/WPTime" android:id="@+id/wpAsr" android:text="--:--" />
            <TextView style="@style/WPName" android:id="@+id/wpL6" android:text="Isya" />
            <TextView style="@style/WPTime" android:id="@+id/wpIsha" android:text="--:--" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
