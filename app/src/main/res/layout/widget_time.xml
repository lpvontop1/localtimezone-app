<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1: Jam Zona — waktu legal (TextClock) + waktu matahari -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/wtLoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9AA3C7"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Menteng" />

    <TextClock
        android:id="@+id/wtClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format24Hour="HH:mm"
        android:format12Hour="hh:mm a"
        android:textColor="#E8EBFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wtSolar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFB454"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="☀ --:--  (EoT --)" />

    <TextView
        android:id="@+id/wtDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9AA3C7"
        android:textSize="11sp"
        android:text="waktu matahari sejati · WIB" />
</LinearLayout>
